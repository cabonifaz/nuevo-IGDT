{
  "openapi": "3.0.3",
  "info": {
    "title": "IGDT - API de integración",
    "version": "1.0.0",
    "description": "API para integrar sistemas externos (como el Banco de Talentos, BDT) con IGDT, el maestro único de catálogos. Cada token pertenece a una empresa (tenant) y debe ser habilitado por el Super Administrador. Envíe el token en la cabecera X-Api-Key. Límite: 300 solicitudes por minuto por IP."
  },
  "servers": [
    {
      "url": "/integration/v1"
    }
  ],
  "security": [
    {
      "ApiKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "APIKEY_INVALID"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "MasterItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "table": {
            "type": "string",
            "example": "CLIENT"
          },
          "code": {
            "type": "string",
            "example": "CLI_ANTAMINA_A1B2"
          },
          "label": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "es": "Compañía Minera Antamina",
              "en": "Compañía Minera Antamina"
            }
          },
          "parentId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "num1": {
            "type": "number",
            "nullable": true
          },
          "str1": {
            "type": "string",
            "nullable": true
          },
          "sortOrder": {
            "type": "integer"
          },
          "isActive": {
            "type": "boolean"
          },
          "isTenantOwned": {
            "type": "boolean"
          }
        }
      },
      "CatalogChange": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "integer",
            "description": "Posición del cambio (creciente)"
          },
          "entity": {
            "type": "string",
            "enum": [
              "MASTER_ITEM",
              "CLIENT_CONTACT",
              "TARIFF"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "op": {
            "type": "string",
            "enum": [
              "UPSERT",
              "DELETE"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "type": "object",
            "description": "Estado actual del registro (MASTER_ITEM: table, code, label, tenantScoped, str1-3, num1-3, sortOrder, active, deleted; CLIENT_CONTACT: clientId, nombres, cargo, correos, teléfonos, deleted; TARIFF: clientId, profileId, currencyId, rateTypeId, rate, validFrom, validTo, deleted)"
          }
        }
      },
      "SyncResults": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "ok": {
                  "type": "boolean"
                },
                "applied": {
                  "type": "boolean",
                  "description": "RQ: false si el envío era más viejo que el guardado"
                },
                "event": {
                  "type": "string",
                  "enum": [
                    "NEW",
                    "REOPENED",
                    "UPDATED",
                    "CANCELLED",
                    "NONE"
                  ]
                },
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Requirement": {
        "type": "object",
        "required": [
          "id",
          "code",
          "title",
          "status",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "group": {
                "type": "string",
                "enum": [
                  "OPEN",
                  "CLOSED"
                ]
              }
            }
          },
          "client": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "label": {
                "type": "string"
              }
            }
          },
          "owner": {
            "type": "string"
          },
          "requestDate": {
            "type": "string",
            "format": "date"
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          },
          "closedAt": {
            "type": "string",
            "format": "date-time"
          },
          "conditions": {
            "type": "object",
            "properties": {
              "workModality": {
                "type": "string"
              },
              "duration": {
                "type": "string"
              },
              "contract": {
                "type": "string"
              },
              "emo": {
                "type": "boolean"
              },
              "sctr": {
                "type": "boolean"
              },
              "laptop": {
                "type": "boolean"
              }
            }
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "order": {
                  "type": "integer"
                }
              }
            }
          },
          "vacancies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "profile": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "label": {
                      "type": "string"
                    }
                  }
                },
                "quantity": {
                  "type": "integer"
                },
                "rateInitial": {
                  "type": "number"
                },
                "rateFinal": {
                  "type": "number"
                }
              }
            }
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "vacancyId": {
                  "type": "string",
                  "format": "uuid"
                },
                "talentId": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string"
                },
                "headline": {
                  "type": "string"
                },
                "stage": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "order": {
                      "type": "integer"
                    }
                  }
                },
                "stageAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "addedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "resigned": {
                  "type": "boolean"
                }
              }
            }
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "deleted": {
            "type": "boolean"
          }
        }
      },
      "Hire": {
        "type": "object",
        "required": [
          "id",
          "active"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "uuid del candidato en BDT"
          },
          "active": {
            "type": "boolean",
            "description": "true: confirmado y vigente; false: se retiró la confirmación"
          },
          "requirement": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "code": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "client": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "label": {
                "type": "string"
              }
            }
          },
          "vacancy": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "profile": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "label": {
                    "type": "string"
                  }
                }
              },
              "rateInitial": {
                "type": "number"
              },
              "rateFinal": {
                "type": "number"
              }
            }
          },
          "talent": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "firstName": {
                "type": "string"
              },
              "lastName": {
                "type": "string"
              },
              "secondLastName": {
                "type": "string"
              },
              "headline": {
                "type": "string"
              },
              "docType": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                }
              },
              "docNumber": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              }
            }
          },
          "conditions": {
            "type": "object",
            "properties": {
              "workModality": {
                "type": "string"
              },
              "duration": {
                "type": "string"
              },
              "contract": {
                "type": "string"
              },
              "emo": {
                "type": "boolean"
              },
              "sctr": {
                "type": "boolean"
              },
              "laptop": {
                "type": "boolean"
              }
            }
          },
          "confirmedBy": {
            "type": "string"
          },
          "confirmedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "API key ausente o inválida",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "API key no habilitada o sin el scope requerido",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "TooMany": {
        "description": "Límite de solicitudes superado"
      }
    }
  },
  "paths": {
    "/whoami": {
      "get": {
        "summary": "Identidad de la API key",
        "responses": {
          "200": {
            "description": "Tenant y scopes de la key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tenant": {
                      "type": "string"
                    },
                    "keyId": {
                      "type": "string"
                    },
                    "scopes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/masters": {
      "get": {
        "summary": "Catálogos (maestro de maestros) visibles para el tenant",
        "description": "Requiere el scope masters.read.",
        "parameters": [
          {
            "name": "tables",
            "in": "query",
            "required": false,
            "description": "Códigos de catálogo separados por coma (CLIENT,RQ_PROFILE,CURRENCY,...)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Valores",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MasterItem"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooMany"
          }
        }
      }
    },
    "/catalog/changes": {
      "get": {
        "summary": "Cambios de los catálogos compartidos desde un cursor",
        "description": "Requiere masters.read. Devuelve los cambios posteriores a since, en orden, con el estado actual de cada registro. Guarde next y envíelo como since en la próxima llamada; mientras more sea true quedan cambios.",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 500,
              "maximum": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de cambios",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "changes": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CatalogChange"
                      }
                    },
                    "next": {
                      "type": "integer"
                    },
                    "more": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooMany"
          }
        }
      }
    },
    "/catalog/import": {
      "post": {
        "summary": "Carga inicial de catálogos existentes",
        "description": "Requiere catalog.import. Se usa una vez al conectar: clientes y perfiles (items) y contactos. Lo nuevo se crea con el mismo id; si el código ya existe no se pisa y se devuelve el id de IGDT. Repetible sin duplicar.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "table": {
                          "type": "string",
                          "enum": [
                            "CLIENT",
                            "RQ_PROFILE"
                          ]
                        },
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "code": {
                          "type": "string"
                        },
                        "label": {
                          "type": "object"
                        },
                        "str1": {
                          "type": "string"
                        },
                        "str2": {
                          "type": "string"
                        },
                        "sortOrder": {
                          "type": "integer"
                        },
                        "active": {
                          "type": "boolean"
                        }
                      }
                    }
                  },
                  "contacts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "clientId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "firstName": {
                          "type": "string"
                        },
                        "lastName": {
                          "type": "string"
                        },
                        "position": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string"
                        },
                        "phone": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mapeo de ids",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "map": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "entity": {
                            "type": "string"
                          },
                          "sourceId": {
                            "type": "string"
                          },
                          "igdtId": {
                            "type": "string"
                          },
                          "created": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/requirements": {
      "post": {
        "summary": "Publicar requerimientos de BDT",
        "description": "Requiere requirements.write. Último estado de cada RQ (lote de hasta 50) con vacantes y postulantes; IGDT lo muestra en solo lectura. Un envío con updatedAt más viejo que el guardado se ignora (applied=false). deleted=true lo quita de la bandeja.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "items"
                ],
                "properties": {
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50,
                    "items": {
                      "$ref": "#/components/schemas/Requirement"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado por elemento",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResults"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/hires": {
      "post": {
        "summary": "Candidatos confirmados (solicitudes de ingreso)",
        "description": "Requiere hires.write. active=true crea o actualiza la solicitud de ingreso del candidato (o la reabre si estaba cancelada); active=false la cancela si aún no se completó. Idempotente. Los datos personales viajan por TLS y se guardan cifrados.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "items"
                ],
                "properties": {
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50,
                    "items": {
                      "$ref": "#/components/schemas/Hire"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado por elemento",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResults"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    }
  }
}
